#!/usr/bin/env -S v run

// gen_builtin.vsh writes arxmodel/builtin.v from the files the library carries built in, and
// arxmodel/builtin_test.v, which pins each text to its file:
//   v run scripts/gen_builtin.vsh
// Run it after changing one of them; builtin_test.v fails until you do. vendor_flatxml.sh runs it.
import os

const root = os.dir(os.dir(@FILE))

// const name -> file, relative to the repository. ONE list: builtin_test.v carries it as
// `builtin_files`, which the test walks; the library itself never reads it.
const table = [
	['default_policy_text', 'arxmodel/policy.toml'],
	['automat_policy_text', 'arxmodel/automat.policy.toml'],
	['identity_text', 'arxmodel/identity.toml'],
	['flatxml_vendored_text', 'flatxml/VENDORED'],
	['vmod_text', 'v.mod'], // @VMOD_FILE is the nearest v.mod: a host's, once vendored
]

fn literal(s string) string {
	mut out := []string{}
	lines := s.split('\n')
	for k, line in lines {
		if k == lines.len - 1 && line == '' {
			break
		}
		esc := line.replace('\\', '\\\\').replace("'", "\\'").replace('$', '\\$').replace('\t',
			'\\t').replace('\r', '\\r')
		nl := if k < lines.len - 1 { '\\n' } else { '' }
		out << "\t'${esc}${nl}'"
	}
	return if out.len == 0 { "''" } else { out.join(' +\n').trim_left('\t') }
}

mut out := []string{}
out << 'module arxmodel'
out << ''
out << '// GENERATED by scripts/gen_builtin.vsh from the files it names; do not edit: builtin_test.v'
out << '// pins it to them.'
out << '//'
out << '// The texts are spelled out rather than taken with \$embed_file because V3 embeds a'
out << '// \$embed_file only in a -prod build: otherwise it records the BUILD machine\'s path and reads'
out << '// that file at run time, failing on every machine but the one that built the program.'
for t in table {
	text := os.read_file(os.join_path(root, t[1]))!
	out << ''
	out << '// ${t[1]}'
	out << 'const ${t[0]} = ${literal(text)}'
}
os.write_file(os.join_path(root, 'arxmodel', 'builtin.v'), out.join('\n') + '\n')!

mut test := []string{}
test << 'module arxmodel'
test << ''
test << 'import os'
test << ''
test << '// GENERATED by scripts/gen_builtin.vsh with builtin.v; do not edit.'
test << ''
test << '// builtin_files is every built-in text by the file it was made from.'
test << 'const builtin_files = {'
for t in table {
	test << "\t'${t[1]}': ${t[0]}"
}
test << '}'
test << ''
test << '// The generated texts ARE the files they were made from: change one and forget'
test << '// scripts/gen_builtin.vsh, and this fails rather than the library carrying the old text.'
test << 'fn test_the_builtin_texts_are_the_files() {'
test << '\tfor path, text in builtin_files {'
test << "\t\tassert text == os.read_file(os.join_path(@VMODROOT, path))!, '\${path} changed: v run scripts/gen_builtin.vsh'"
test << '\t}'
test << '}'
os.write_file(os.join_path(root, 'arxmodel', 'builtin_test.v'), test.join('\n') + '\n')!
println('wrote arxmodel/builtin.v and arxmodel/builtin_test.v')
