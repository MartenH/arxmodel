<?xml version="1.0" encoding="UTF-8"?>
<!-- A synthetic schema for arxmodel's tests: one group, an alternative of a choice in one holder
     and a plain part of a sequence in another; its role X is required. -->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:A="urn:arxmodel:test:alt"
            targetNamespace="urn:arxmodel:test:alt" elementFormDefault="qualified">
   <xsd:group name="G">
      <xsd:sequence>
         <xsd:element name="X" type="xsd:string" minOccurs="0">
            <xsd:annotation><xsd:appinfo source="tags">mmt.qualifiedName="G.x";pureMM.maxOccurs="1";pureMM.minOccurs="1"</xsd:appinfo></xsd:annotation>
         </xsd:element>
      </xsd:sequence>
   </xsd:group>
   <xsd:complexType name="CHOOSING">
      <xsd:choice minOccurs="0">
         <xsd:group ref="A:G"/>
         <xsd:element name="Y" type="xsd:string">
            <xsd:annotation><xsd:appinfo source="tags">mmt.qualifiedName="Choosing.y";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo></xsd:annotation>
         </xsd:element>
      </xsd:choice>
   </xsd:complexType>
   <xsd:complexType name="PLAIN">
      <xsd:sequence>
         <xsd:group ref="A:G"/>
      </xsd:sequence>
   </xsd:complexType>
   <xsd:complexType name="TOP">
      <xsd:sequence>
         <xsd:element name="CHOOSING" type="A:CHOOSING" minOccurs="0">
            <xsd:annotation><xsd:appinfo source="tags">mmt.qualifiedName="Top.choosing";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo></xsd:annotation>
         </xsd:element>
         <xsd:element name="PLAIN" type="A:PLAIN" minOccurs="0">
            <xsd:annotation><xsd:appinfo source="tags">mmt.qualifiedName="Top.plain";pureMM.maxOccurs="1";pureMM.minOccurs="0"</xsd:appinfo></xsd:annotation>
         </xsd:element>
      </xsd:sequence>
   </xsd:complexType>
   <xsd:element name="TOP" type="A:TOP"/>
</xsd:schema>
